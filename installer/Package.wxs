<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="AgentFlow"
           Manufacturer="djgene01"
           Version="$(var.ProductVersion)"
           UpgradeCode="544B28E6-653F-4388-B3C7-A9EA0398688F"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="AgentFlow: a workflow frontend that runs Claude Code" />

    <!-- A newer version replaces an older one in place; installing an older one over a newer one is refused. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of AgentFlow is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon for the shortcuts and for Settings > Apps. -->
    <Icon Id="AgentFlowIcon" SourceFile="$(var.AssetsDir)\AgentFlow.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgentFlowIcon" />
    <Property Id="ARPCOMMENTS" Value="Workflow frontend that runs the Claude Code CLI installed on this computer." />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgentFlow" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Everything from the self-contained publish folder. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- Desktop and Start menu shortcuts. -->
    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="6C8D3E2A-1F4B-4C7E-9A5D-2B0E8F1C3D47">
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="AgentFlow"
                Description="Plan, build and review with Claude Code"
                Target="[INSTALLFOLDER]AgentFlow.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AgentFlowIcon" />
      <Shortcut Id="StartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="AgentFlow"
                Description="Plan, build and review with Claude Code"
                Target="[INSTALLFOLDER]AgentFlow.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AgentFlowIcon" />
      <!-- Shortcuts count as per-user data, so their component's key path is a per-user value (WiX's standard pattern, ICE57). -->
      <RegistryValue Root="HKCU" Key="Software\djgene01\AgentFlow" Name="ShortcutsInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="AgentFlow" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- Wizard: welcome, notice, folder, install, finish with "Launch AgentFlow". -->
    <WixVariable Id="WixUILicenseRtf" Value="Notice.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch AgentFlow" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Resolved after the install folder is known, so the finish page can start the installed app. -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]AgentFlow.exe" After="CostFinalize" Sequence="ui" />
    <CustomAction Id="LaunchAgentFlow" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAgentFlow"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
