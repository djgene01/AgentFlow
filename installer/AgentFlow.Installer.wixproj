<Project Sdk="WixToolset.Sdk/6.0.2">
  <!--
    Builds AgentFlow-<version>-x64.msi from a self-contained publish of the app.
    Use build-installer.ps1, which publishes first and then builds this project.
    WiX v6 is used on purpose: v7 requires accepting the Open Source Maintenance Fee EULA first.
  -->
  <PropertyGroup>
    <OutputName>AgentFlow-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\src\AgentFlow.App\Assets</DefineConstants>
    <!-- Every file in the publish folder changes with each build, so let WiX make the component GUIDs. -->
    <!-- ICE61: same-version upgrades are allowed. ICE60: a few runtime DLLs carry versions without a language; harmless. -->
    <SuppressIces>ICE60;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
