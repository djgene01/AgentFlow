<UserControl x:Class="AgentFlow.App.Views.WorkflowBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:b="clr-namespace:AgentFlow.App.ViewModels.Builder"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance b:WorkflowBuilderViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Workflow list -->
        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,6">
                    <TextBlock Text="Workflows" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProjectName, StringFormat='Library and {0}'}" Style="{StaticResource SecondaryText}"
                               Visibility="{Binding ProjectName, Converter={StaticResource NullToCollapsed}}" />
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,4,0" />
                        <Button Content="Import…" Command="{Binding ImportCommand}" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent" Margin="6,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type b:WorkflowListItem}">
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run x:Name="StatusRun" Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter TargetName="StatusRun" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Nothing selected / unreadable file -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding Editor, Converter={StaticResource NullToVisible}}">
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding LoadError, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,12" />
            <TextBlock Text="Choose a workflow on the left, or press New." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Editor -->
        <Grid Grid.Column="1" DataContext="{Binding Editor}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Workflow header -->
            <Border Padding="20,14,20,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" ToolTip="Workflow name" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" ToolTip="What this workflow is for (optional)" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80" Margin="0,0,6,0" />
                            <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,6,0" ToolTip="Discard unsaved changes" />
                            <Button Content="Clone" Command="{Binding CloneCommand}" Margin="0,0,6,0" />
                            <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,6,0" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Save to" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SaveScope}" MinWidth="200" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" MaxWidth="460" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Validation -->
            <Border Grid.Row="1" Margin="20,10,20,0" Padding="10,6" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Ready to run." Visibility="{Binding IsValid, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Errors}" Visibility="{Binding IsValid, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="20,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Stage list: drag to reorder -->
                <DockPanel Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Top" Text="Stages (drag to reorder)" Style="{StaticResource SecondaryText}" Margin="2,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="AddStageButton" Content="Add stage ▾" HorizontalAlignment="Stretch" Click="AddStageButton_Click" />
                        <UniformGrid Columns="3" Margin="0,6,0,0">
                            <Button Content="↑" Command="{Binding MoveUpCommand}" ToolTip="Move up" Margin="0,0,3,0" />
                            <Button Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Move down" Margin="3,0,3,0" />
                            <Button Content="Remove" Command="{Binding RemoveStageCommand}" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                    <ListBox x:Name="StageList" ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}"
                             AllowDrop="True" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="StageList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="StageList_PreviewMouseMove"
                             Drop="StageList_Drop" DragOver="StageList_DragOver">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type b:StageEditorViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontWeight="SemiBold" FontSize="15"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Stage form -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,0,20,16"
                              DataContext="{Binding SelectedStage}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Stage name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key (used in variables)" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Key, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                                         ToolTip="Renaming the key updates every reference to it in this workflow." />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                                <ComboBox IsEditable="True" ItemsSource="{x:Static b:StageEditorViewModel.ModelSuggestions}"
                                          Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="A model alias or full name. Empty uses the CLI's default model." />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Effort" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{x:Static b:StageEditorViewModel.Efforts}" SelectedItem="{Binding Effort}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Permissions" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static b:StageEditorViewModel.Presets}" SelectedItem="{Binding Preset}" />
                        <StackPanel Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Permission mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{x:Static b:StageEditorViewModel.CustomModes}" SelectedItem="{Binding CustomMode}" Width="200" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Also allow (one rule per line)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AllowedToolsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="For example PowerShell(npm run lint *) or Bash(make *)" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Deny (one rule per line)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DisallowedToolsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="For example WebFetch" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Session" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding SessionOptions}" SelectedItem="{Binding Session}" />
                        <TextBlock Text="A new session gives an independent view; continuing keeps the earlier stage's context." Style="{StaticResource Hint}" />

                        <CheckBox IsChecked="{Binding WaitForApproval}" Margin="0,12,0,0">
                            <TextBlock Text="Wait for my approval after this stage" TextWrapping="Wrap" />
                        </CheckBox>
                        <!-- TextBlock content: a plain string would treat "_" as an access-key marker. -->
                        <CheckBox IsChecked="{Binding ReturnsVerdict}" Margin="0,6,0,0">
                            <TextBlock Text="Return a review verdict (pass or changes_requested, with findings)" TextWrapping="Wrap" />
                        </CheckBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Max turns (empty = no limit)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MaxTurnsText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Budget, USD (empty = none)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding MaxBudgetText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Role (added to Claude Code's system prompt)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding RolePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" MaxHeight="180" VerticalScrollBarVisibility="Auto" />

                        <DockPanel Margin="0,10,0,3">
                            <Button DockPanel.Dock="Right" Content="Insert variable ▾" Click="InsertVariable_Click" Padding="8,2" />
                            <TextBlock Text="Prompt for this stage" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <TextBox x:Name="PromptBox" Text="{Binding PromptTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="140" MaxHeight="360" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                        <TextBlock Text="{}{{task}} is your message. {{stages.&lt;key&gt;.result}} is another stage's final answer; {{git.diff}} is the change since the run started."
                                   Style="{StaticResource Hint}" />

                        <TextBlock Text="After this stage" Style="{StaticResource FieldLabel}" Margin="0,14,0,3" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="With no rules the run continues with the next stage. With rules, the first match wins; if none match, the run ends." />
                        <ItemsControl ItemsSource="{Binding Transitions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type b:TransitionEditorViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="When" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox ItemsSource="{x:Static b:TransitionEditorViewModel.Conditions}" SelectedItem="{Binding When}" Width="210" />
                                        <TextBlock Text="go to" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <ComboBox ItemsSource="{Binding DataContext.GotoOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  SelectedItem="{Binding Goto}" Width="130" />
                                        <TextBlock Text="at most" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <TextBox Text="{Binding MaxLoopsText, UpdateSourceTrigger=PropertyChanged}" Width="50" ToolTip="Empty = no limit" />
                                        <TextBlock Text="times" VerticalAlignment="Center" Margin="6,0,10,0" />
                                        <Button Content="Remove" Command="{Binding DataContext.RemoveTransitionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add rule" Command="{Binding AddTransitionCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
