<UserControl x:Class="AgentFlow.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AgentFlow.App.ViewModels"
             xmlns:wf="clr-namespace:AgentFlow.Core.Workflows;assembly=AgentFlow.Core"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChatViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextMatchCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousMatchCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusComposerCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding StopCommand}" />
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewSessionCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.ColumnSpan="2" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right"
                               Visibility="{Binding UsageText, Converter={StaticResource NullToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Search" Command="{Binding OpenSearchCommand}" Padding="6,1" FontSize="12" Margin="0,0,6,0" ToolTip="Search this chat (Ctrl+F)" />
                        <Button Content="Export…" Command="{Binding ExportChatCommand}" Padding="6,1" FontSize="12" Margin="0,0,6,0" ToolTip="Save the whole chat as Markdown" />
                        <Button Content="Git" Command="{Binding DataContext.ShowGitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Padding="6,1" FontSize="12" Margin="0,0,6,0" ToolTip="Commit and push this project to GitHub" />
                        <Button Content="Open in terminal" Command="{Binding OpenInTerminalCommand}" Padding="6,1" FontSize="12" Margin="0,0,6,0"
                                ToolTip="Continue this project's Claude Code session in the interactive CLI" />
                        <Button Content="{Binding AllowRulesLabel}" Command="{Binding ToggleAllowRulesCommand}"
                                Padding="6,1" FontSize="12" ToolTip="Rules you chose Always allow for in this project" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search bar (Ctrl+F) -->
        <Border Grid.Row="1" Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Padding="8,6"
                Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="280"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Enter: next match · Shift+Enter: previous · Esc: close" />
                <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0" MinWidth="70" />
                <Button Content="↑" Command="{Binding PreviousMatchCommand}" ToolTip="Previous (Shift+F3)" Margin="0,0,4,0" />
                <Button Content="↓" Command="{Binding NextMatchCommand}" ToolTip="Next (F3)" Margin="0,0,8,0" />
                <Button Content="Close" Command="{Binding CloseSearchCommand}" />
            </StackPanel>
        </Border>

        <!-- Always-allowed rules for this project (opened from the header) -->
        <Border Grid.Row="1" Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0" Width="380"
                Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding ShowAllowRules, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Close" Command="{Binding ToggleAllowRulesCommand}" Padding="6,1" />
                    <TextBlock Text="Always allowed in this project" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Passed to every turn as allow rules. Remove one to be asked again." Style="{StaticResource SecondaryText}"
                           TextTrimming="None" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="None yet." Style="{StaticResource SecondaryText}"
                           Visibility="{Binding AllowRules.Count, Converter={StaticResource ZeroToVisible}}" />
                <ItemsControl ItemsSource="{Binding AllowRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Remove" Padding="6,1"
                                        Command="{Binding DataContext.RemoveAllowRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Timeline -->
        <ListBox x:Name="Timeline" Grid.Row="1" ItemsSource="{Binding Entries}"
                 BorderThickness="0" Background="Transparent" Padding="20,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <!-- Search highlight: a tint on every match, an accent edge on the current one. -->
                                <Border x:Name="Hit" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="6,0,0,0" Margin="-9,0,0,0" CornerRadius="2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                        <Setter TargetName="Hit" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentHit}" Value="True">
                                        <Setter TargetName="Hit" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Hit" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Run panel: the stages of the current or last workflow run -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Width="250" BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="{DynamicResource LayerFillColorDefaultBrush}"
                Visibility="{Binding RunPanel, Converter={StaticResource NullToCollapsed}}">
            <StackPanel Margin="14,14" DataContext="{Binding RunPanel}">
                <TextBlock Text="{Binding WorkflowName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,12" />
                <Border Padding="8,5" Margin="0,0,0,12" CornerRadius="6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding IsUnattended, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Set on the Claude Code status page. Deny rules and read-only stages still apply.">
                    <TextBlock Text="Unattended: permission prompts are allowed automatically and listed in the chat." TextWrapping="Wrap" FontSize="12" />
                </Border>
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StageStatusViewModel}">
                            <Border x:Name="Row" Padding="8,6" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icon" Text="○" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding Metrics}" Style="{StaticResource SecondaryText}"
                                                   Visibility="{Binding Metrics, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static wf:StageRunStatus.Running}">
                                    <Setter TargetName="Icon" Property="Text" Value="●" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static wf:StageRunStatus.AwaitingApproval}">
                                    <Setter TargetName="Icon" Property="Text" Value="◐" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static wf:StageRunStatus.Succeeded}">
                                    <Setter TargetName="Icon" Property="Text" Value="✓" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static wf:StageRunStatus.Failed}">
                                    <Setter TargetName="Icon" Property="Text" Value="✕" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static wf:StageRunStatus.Cancelled}">
                                    <Setter TargetName="Icon" Property="Text" Value="■" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Totals}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="2" Padding="20,10,20,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <!-- Push-to-talk: shown while listening and while the last words are finished. -->
                <StackPanel x:Name="VoiceBar" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="●" Foreground="#E5484D" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ProgressBar Width="90" Height="6" Minimum="0" Maximum="1" Value="{Binding Voice.Level, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Voice.ListeningText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Voice.KeyLabel, StringFormat=' · let go of {0} to finish'}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="DraftBox_PreviewKeyDown" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Choices wrap onto a second line in a narrow window; the buttons stay on the right. -->
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow}" MinWidth="190" Margin="0,0,4,6"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                                  ToolTip="Direct chat sends one message. A workflow runs its stages in this chat." />
                        <Button Content="↻" Command="{Binding RefreshWorkflowsCommand}" Margin="0,0,12,6" ToolTip="Reload workflow files" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsWorkflowMode, Converter={StaticResource InverseBoolToVisibility}}">
                            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="120" Margin="0,0,8,6"
                                      ToolTip="Model for this message" />
                            <ComboBox ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort}" MinWidth="130" Margin="0,0,8,6"
                                      ToolTip="Effort for this message. Available levels depend on the model." />
                            <ComboBox ItemsSource="{Binding PermissionModes}" SelectedItem="{Binding SelectedPermissionMode}" MinWidth="150" Margin="0,0,8,6"
                                      ToolTip="What Claude Code may do without asking. Anything that would need approval is denied and shown in the chat." />
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="■ Stop reading" Command="{Binding Voice.StopSpeakingCommand}" Margin="0,0,8,0" Focusable="False"
                                ToolTip="Stop reading the reply aloud (Esc)"
                                Visibility="{Binding Voice.IsSpeaking, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        <Button x:Name="MicButton" Content="🎤" Margin="0,0,8,0" MinWidth="40" Focusable="False"
                                ToolTip="{Binding Voice.MicHint}"
                                Visibility="{Binding Voice, Converter={StaticResource NullToCollapsed}}"
                                PreviewMouseLeftButtonDown="MicButton_Down" PreviewMouseLeftButtonUp="MicButton_Up" LostMouseCapture="MicButton_LostCapture" />
                        <Button Content="New session" Command="{Binding NewSessionCommand}" Margin="0,0,8,0"
                                ToolTip="Start a fresh Claude Code session for the next direct message. The history stays." />
                        <!-- Queue while something runs; Send or Run workflow otherwise. -->
                        <Button Content="{Binding SendLabel}" Command="{Binding SendCommand}" MinWidth="80" Margin="0,0,8,0"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding WorkflowHint}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
