<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentFlow.Core\AgentFlow.Core.csproj" />
    <ProjectReference Include="..\AgentFlow.ClaudeCli\AgentFlow.ClaudeCli.csproj" />
    <ProjectReference Include="..\AgentFlow.CtrlC\AgentFlow.CtrlC.csproj" />
    <ProjectReference Include="..\AgentFlow.Storage\AgentFlow.Storage.csproj" />
    <ProjectReference Include="..\AgentFlow.Permissions\AgentFlow.Permissions.csproj" />
    <ProjectReference Include="..\AgentFlow.Speech\AgentFlow.Speech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AgentFlow.ico" />
    <Resource Include="Assets\splash.gif" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AgentFlow.ico</ApplicationIcon>
    <AssemblyName>AgentFlow</AssemblyName>
    <RootNamespace>AgentFlow.App</RootNamespace>
    <Product>AgentFlow</Product>
    <Company>djgene01</Company>
    <Description>Workflow frontend that runs Claude Code</Description>
    <Version>1.3.2</Version>
    <!-- The UI is English only; leave out other languages' framework resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
