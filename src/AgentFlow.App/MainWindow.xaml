<Window x:Class="AgentFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AgentFlow.App.ViewModels"
        xmlns:views="clr-namespace:AgentFlow.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="AgentFlow (runs Claude Code)" Width="1280" Height="820" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Icon="pack://application:,,,/AgentFlow;component/Assets/AgentFlow.ico">
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding SelectProjectByNumberCommand}" CommandParameter="9" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" MinWidth="210" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar (styles in Themes/Sidebar.xaml, bounce in Views/Jelly.cs) -->
        <Grid Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- A faint wash of the accent colour at the top, fading out. -->
            <Border Grid.RowSpan="5" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.08" IsHitTestVisible="False">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Black" Offset="0" />
                        <GradientStop Color="Transparent" Offset="0.45" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="18,18,12,4">
                <Image Source="pack://application:,,,/AgentFlow;component/Assets/AgentFlow.ico" Width="24" Height="24"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="AgentFlow" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,12,14,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource JellyRoundButton}" Tag="&#xE710;" Width="26" Height="26"
                        Command="{Binding AddProjectCommand}" ToolTip="Add a project folder" AutomationProperties.Name="Add project" />
                <TextBlock Text="PROJECTS" Style="{StaticResource SidebarLabel}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </DockPanel>

            <ListBox Grid.Row="2" x:Name="ProjectList" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                     BorderThickness="0" Background="Transparent" Margin="0,6,0,0" Padding="0"
                     ItemContainerStyle="{StaticResource ProjectItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProjectItemViewModel}">
                        <Grid Background="Transparent" Tag="{Binding DataContext, ElementName=ProjectList}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove project…"
                                              Command="{Binding PlacementTarget.Tag.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Avatar: a soft coloured tile with the first letter; a pulsing ring while Claude works. -->
                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" Margin="-3" Opacity="0"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform />
                                    </Border.RenderTransform>
                                </Border>
                                <Border CornerRadius="10" Background="{Binding Name, Converter={StaticResource NameToBrush}}">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Sub" Text="{Binding FolderPath}" Style="{StaticResource SecondaryText}" FontSize="11.5"
                                           ToolTip="{Binding FolderPath}" />
                            </StackPanel>
                            <Button x:Name="Remove" Grid.Column="2" Style="{StaticResource RowIconButton}" Tag="&#xE74D;"
                                    Visibility="Hidden" ToolTip="Remove project" AutomationProperties.Name="Remove project"
                                    Command="{Binding DataContext.RemoveProjectCommand, ElementName=ProjectList}" CommandParameter="{Binding}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Sub" Property="Text" Value="Claude is working…" />
                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="Pulse">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                             From="0.9" To="0" Duration="0:0:1.4" />
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.95" To="1.18" Duration="0:0:1.4" EasingFunction="{StaticResource SoftOut}" />
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.95" To="1.18" Duration="0:0:1.4" EasingFunction="{StaticResource SoftOut}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Margin="0,6,0,4">
                <TextBlock Text="TOOLS" Style="{StaticResource SidebarLabel}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="Workflows" Tag="&#xE945;"
                        Command="{Binding ShowWorkflowsCommand}" ToolTip="Build and edit workflows"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=Workflows}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="Git and GitHub" Tag="&#xE895;"
                        Command="{Binding ShowGitCommand}" ToolTip="Sign in to GitHub, commit and push projects"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=Git}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="Video studio" Tag="&#xE714;"
                        Command="{Binding ShowVideoCommand}" ToolTip="Let Claude make videos with VMCP-Studio (MCP)"
                        Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisibility}}"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=Video}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="Pixel Art Studio" Tag="&#xE790;"
                        Command="{Binding ShowPixelArtCommand}" ToolTip="Let Claude draw sprites and animations (MCP)"
                        Visibility="{Binding HasPixelArt, Converter={StaticResource BoolToVisibility}}"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=pixel}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="SfxForge" Tag="&#xE8D6;"
                        Command="{Binding ShowSfxCommand}" ToolTip="Let Claude design 8-bit sound effects (MCP)"
                        Visibility="{Binding HasSfx, Converter={StaticResource BoolToVisibility}}"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=sfx}" />
                <Button Style="{StaticResource SidebarNavButton}" Content="Voice" Tag="&#xE720;"
                        Command="{Binding ShowVoiceCommand}" ToolTip="Push-to-talk and reading replies aloud"
                        Visibility="{Binding HasVoice, Converter={StaticResource BoolToVisibility}}"
                        views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=Voice}" />
            </StackPanel>

            <!-- Claude Code status, with a dot: green when the CLI is found and signed in. -->
            <Border Grid.Row="4" VerticalAlignment="Top" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="16,4,16,0" />
            <Button Grid.Row="4" Style="{StaticResource SidebarNavButton}" Tag="&#xE9D9;" Margin="8,10,8,12"
                    Command="{Binding ShowDiagnosticsCommand}" ToolTip="Check the Claude Code CLI, sign-in and permissions"
                    views:Jelly.IsActive="{Binding ActiveNav, Converter={StaticResource EqualsParameter}, ConverterParameter=Status}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Claude Code status" />
                    <Ellipse Width="8" Height="8" Margin="9,1,0,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFE0A030" />
                                <Setter Property="ToolTip" Value="Needs attention" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Diagnostics.IsReady}" Value="True">
                                        <Setter Property="Fill" Value="#FF3CC27A" />
                                        <Setter Property="ToolTip" Value="Ready" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
            </Button>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" ResizeBehavior="PreviousAndNext" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- Page changes fade in and drift up a few pixels instead of snapping. -->
        <ContentControl Grid.Column="2" Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard Storyboard="{StaticResource PageIn}" />
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>
    </Grid>
</Window>
