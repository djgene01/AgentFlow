<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:AgentFlow.App.Converters"
                    xmlns:views="clr-namespace:AgentFlow.App.Views">

    <!-- The sidebar: soft rounded rows, icons, and a jelly bounce (Views/Jelly.cs). Colours come from the
         Fluent theme, so light, dark and the Windows accent colour all follow the system. -->

    <conv:EqualsParameterConverter x:Key="EqualsParameter" />
    <conv:NameToBrushConverter x:Key="NameToBrush" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <ElasticEase x:Key="PillSpring" EasingMode="EaseOut" Oscillations="2" Springiness="4" />
    <CubicEase x:Key="SoftOut" EasingMode="EaseOut" />

    <Style x:Key="SidebarLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="16,10,0,6" />
    </Style>

    <!-- A sidebar entry: icon (Tag) + label (Content). views:Jelly.IsActive marks the open page. -->
    <Style x:Key="SidebarNavButton" TargetType="Button">
        <Setter Property="views:Jelly.Enabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Tint" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" Opacity="0"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <Border x:Name="Pill" Width="3" Height="0" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2,0,0,0"
                                VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="14,9,10,9">
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Width="20" TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" TextBlock.FontSize="13.5" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="views:Jelly.IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="18"
                                                         Duration="0:0:0.55" EasingFunction="{StaticResource PillSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.13" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="0"
                                                         Duration="0:0:0.18" EasingFunction="{StaticResource SoftOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A round accent button with an icon (the + next to Projects). -->
    <Style x:Key="JellyRoundButton" TargetType="Button">
        <Setter Property="views:Jelly.Enabled" Value="True" />
        <Setter Property="views:Jelly.HoverScale" Value="1.12" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Disc" CornerRadius="15" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Direction="270" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="15" BorderThickness="2" Margin="-3" Opacity="0"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small icon-only button that shows on a project row while the mouse is over it. -->
    <Style x:Key="RowIconButton" TargetType="Button">
        <Setter Property="views:Jelly.Enabled" Value="True" />
        <Setter Property="views:Jelly.HoverScale" Value="1.15" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                        <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground" Value="#FFE5484D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Project rows: the same soft card, the spring-in accent pill for the open project. -->
    <Style x:Key="ProjectItem" TargetType="ListBoxItem">
        <Setter Property="views:Jelly.Enabled" Value="True" />
        <Setter Property="views:Jelly.HoverScale" Value="1.02" />
        <Setter Property="views:Jelly.IsActive" Value="{Binding IsSelected, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Tint" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" Opacity="0"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <Border x:Name="Pill" Width="3" Height="0" CornerRadius="1.5" HorizontalAlignment="Left" Margin="2,0,0,0"
                                VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <ContentPresenter Margin="10,8,6,8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="22"
                                                         Duration="0:0:0.55" EasingFunction="{StaticResource PillSpring}" />
                                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0.15" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Height" To="0"
                                                         Duration="0:0:0.18" EasingFunction="{StaticResource SoftOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page changes fade and drift up a few pixels instead of snapping. -->
    <Storyboard x:Key="PageIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource SoftOut}" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0"
                         Duration="0:0:0.32" EasingFunction="{StaticResource SoftOut}" />
    </Storyboard>
</ResourceDictionary>
