<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Push-to-talk speech to text: NVIDIA Parakeet TDT (ONNX) on ONNX Runtime.
    DirectML runs the encoder on any DirectX 12 GPU (AMD, Intel or NVIDIA); the CPU is the fallback.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Kokoro's own G2P (misaki) ported to C#: text to the phonemes Kokoro reads. Apache-2.0, no espeak needed. -->
    <PackageReference Include="MisakiSharp" Version="2.2.0" />
  </ItemGroup>

  <!--
    Microsoft.AI.DirectML only copies DirectML.dll into C++ projects. Copy it next to onnxruntime.dll ourselves:
    Windows' own System32\DirectML.dll is far older than ONNX Runtime needs.
  -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll" Link="DirectML.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
